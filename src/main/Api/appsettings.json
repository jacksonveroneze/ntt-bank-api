{
  "Application": {
    "Name": "NttBank.Api",
    "Version": "1.1.0",
    "Description": "NttBank API"
  },
  "Serilog": {
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/metrics' or RequestPath like '/health/startup' or RequestPath like '/health/ready' or RequestPath like '/health/live'"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information",
        "CorrelationId.CorrelationIdMiddleware": "Warning"
      }
    }
  },
  "Cache": {
    "UseDistributed": true,
    "UseSsl": false
  }
}
